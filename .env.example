# ─────────────────────────────────────────────────────────────────────────────
# ResWatch Retail — Environment Variables
# .env is included in this branch for demo/judge use. To run your own instance:
#   1. Create a Supabase project and fill in the values below.
#   2. Copy the Session pooler string from: Supabase Dashboard → Connect (top bar)
#      → "Session pooler" tab → copy the postgresql://... string.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase — Backend (service role; stays on server, never in browser)
# Get the exact DATABASE_URL from your Supabase Dashboard → Connect → Session pooler.
# The host prefix (aws-0 / aws-1 / etc.) varies by project and region — always
# use the string the dashboard gives you, not a guessed value.
# If your DB password contains "@", URL-encode it as "%40".
# Always append ?sslmode=require.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-N-REGION.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_KEY=your_service_role_key_here
JWKS_URL=https://PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# Supabase — Frontend (Vite prefix required; safe to expose in browser)
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
VITE_API_BASE_URL=http://localhost:8000

# App Config — all have safe defaults, tweak as needed
CORS_ORIGINS=
TARIFF_REGION=peninsular
ELECTRICITY_TARIFF_MYR_PER_KWH=0.5443
WATER_TARIFF_MYR_PER_M3=3.51
CO2E_KG_PER_KWH=0.574
FORECAST_HORIZON_DAYS=7
ANOMALY_ZSCORE_THRESHOLD=2.5
SCHEDULE_SOLVER_TIMEOUT_SEC=5
DEFAULT_STORE_NAME=Demo Retail Store
